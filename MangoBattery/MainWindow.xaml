<Window
    x:Class="MangoBattery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <TextBlock Text="MangoBattery"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
            <StackPanel Spacing="12">

                <!-- Header -->
                <StackPanel Spacing="2">
                    <TextBlock x:Name="MachineNameText"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="SnapshotTimeText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Error / no-battery banner -->
                <InfoBar x:Name="StatusInfoBar"
                         IsClosable="False"
                         IsOpen="False"/>

                <!-- Hero charge card -->
                <Border CornerRadius="{StaticResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Current Charge"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="ChargePercentageText"
                                   FontSize="48"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="ChargeProgressBar"
                                     Maximum="100"
                                     Minimum="0"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <Ellipse x:Name="StatusDot"
                                     Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <TextBlock x:Name="StatusText"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="RateText"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Battery health card -->
                <Border CornerRadius="{StaticResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Battery Health"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="HealthPercentageText"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </Grid>
                        <ProgressBar x:Name="HealthProgressBar"
                                     Maximum="100"
                                     Minimum="0"/>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CapacityText"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="CyclesText"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Raw WMI details -->
                <Expander x:Name="DetailsExpander"
                          Header="Details"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="False">
                    <StackPanel x:Name="DetailsPanel" Spacing="16"/>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>